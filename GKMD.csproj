<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>GKMD</AssemblyName>
    <RootNamespace>GKMD</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <LangVersion>latest</LangVersion>

    <Version>4.5.2.0</Version>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <Description>GKMD virtual USB game controller engine (USB/IP backend), derived from hifihedgehog/HIDMaestro 1.5.1.</Description>

    <!-- AOT compatibility: the engine is published and AOT-compiled by its
         host (GKME). IsAotCompatible turns on the trim / AOT / single-file
         analyzers so this library stays linkable from a Native AOT app, and
         the build is kept warning-free (the only reflection/JSON paths live
         in GKLayoutLoader.cs with local IL2026/IL3050 suppressions). -->
    <IsAotCompatible>true</IsAotCompatible>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\USBip-0.9.8.1-x64.exe">
      <LogicalName>GKMD.Resources.USBip-0.9.8.1-x64.exe</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\THIRD-PARTY-NOTICES.txt">
      <LogicalName>GKMD.Resources.THIRD-PARTY-NOTICES.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
