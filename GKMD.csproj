<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Two builds of one assembly. The Windows build rides usbip-win2's
         vhci host controller and carries the upstream installer for this
         architecture; the Linux build rides the in-kernel vhci-hcd driver
         that mainline Linux already provides (module `vhci_hcd`), so it
         embeds no installer and needs no out-of-tree kernel module. A host
         picks the matching build automatically through ProjectReference. -->
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <AssemblyName>GKMD</AssemblyName>
    <RootNamespace>GKMD</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <LangVersion>latest</LangVersion>

    <Version>4.9.0.0</Version>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <Description>GKMD virtual USB game controller engine (USB/IP backend), derived from hifihedgehog/HIDMaestro 1.5.1.</Description>

    <!-- AOT compatibility: the engine is published and AOT-compiled by its
         host (GKME). IsAotCompatible turns on the trim / AOT / single-file
         analyzers so this library stays linkable from a Native AOT app, and
         the build is kept warning-free (the only reflection/JSON paths live
         in GKLayoutLoader.cs with local IL2026/IL3050 suppressions). -->
    <IsAotCompatible>true</IsAotCompatible>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <!-- The Windows build is identified by this constant, so every file that
       P/Invokes into Win32 or reads the registry is compiled only there.
       The Linux build compiles the plain net10.0 TFM instead. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <DefineConstants>$(DefineConstants);GKMD_WINDOWS</DefineConstants>
  </PropertyGroup>

  <!-- One DLL per architecture: every Windows build embeds exactly one
       usbip-win2 installer, so a host ships only the payload its machines
       can load. The choice follows the RuntimeIdentifier when one is given
       (`dotnet build -r win-arm64`, `dotnet publish -r win-arm64` from a
       host), and can be set directly with -p:UsbipPayloadArch=arm64 by a
       host that sets its RID in its own project file instead of on the
       command line. Without either, the build is the x64 one. The Linux
       build embeds no installer at all: mainline Linux already has the
       vhci-hcd USB/IP driver. -->
  <PropertyGroup>
    <UsbipPayloadArch Condition="'$(UsbipPayloadArch)' == '' and '$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.ToLowerInvariant().Contains('arm64'))">arm64</UsbipPayloadArch>
    <UsbipPayloadArch Condition="'$(UsbipPayloadArch)' == ''">x64</UsbipPayloadArch>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows' and '$(UsbipPayloadArch)' == 'arm64'">
    <EmbeddedResource Include="Resources\USBip-0.9.8.1-arm64.exe">
      <LogicalName>GKMD.Resources.USBip-0.9.8.1-arm64.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows' and '$(UsbipPayloadArch)' != 'arm64'">
    <EmbeddedResource Include="Resources\USBip-0.9.8.1-x64.exe">
      <LogicalName>GKMD.Resources.USBip-0.9.8.1-x64.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\THIRD-PARTY-NOTICES.txt">
      <LogicalName>GKMD.Resources.THIRD-PARTY-NOTICES.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="ValidateUsbipPayloadArch" BeforeTargets="BeforeBuild">
    <Error Condition="'$(UsbipPayloadArch)' != 'x64' and '$(UsbipPayloadArch)' != 'arm64'"
           Text="UsbipPayloadArch must be 'x64' or 'arm64' (got '$(UsbipPayloadArch)')." />
  </Target>

  <ItemGroup>
    <!-- The manual Linux smoke test under tools/ is a separate executable;
         keep its sources out of the library build. -->
    <Compile Remove="tools/**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="LICENSE" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="\" />
    <None Include="Resources\THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Release packaging: one zip per artifact. The two Windows builds each
       carry their architecture's usbip-win2 installer; the Linux build is the
       net10.0 assembly and carries no installer payload.

         dotnet build -c Release -f net10.0-windows -t:PackageRelease -r win-x64
         dotnet build -c Release -f net10.0-windows -t:PackageRelease -r win-arm64
         dotnet build -c Release -f net10.0 -t:PackageRelease

       Produces bin\Release\GKMD-v<version>-windows-x64.zip,
       ...-windows-arm64.zip and ...-linux.zip, each containing GKMD.dll,
       LICENSE and THIRD-PARTY-NOTICES.txt so the notices travel with every
       copy. -->
  <Target Name="PackageRelease" DependsOnTargets="Build"
          Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ReleaseVersion>$([System.Version]::Parse('$(Version)').ToString(3))</ReleaseVersion>
      <ReleaseSuffix Condition="'$(TargetFramework)' == 'net10.0'">linux</ReleaseSuffix>
      <ReleaseSuffix Condition="'$(TargetFramework)' == 'net10.0-windows'">windows-$(UsbipPayloadArch)</ReleaseSuffix>
      <ReleaseStageDir>$(MSBuildProjectDirectory)\obj\release-package\GKMD-v$(ReleaseVersion)-$(ReleaseSuffix)</ReleaseStageDir>
      <ReleaseZipPath>$(MSBuildProjectDirectory)\bin\Release\GKMD-v$(ReleaseVersion)-$(ReleaseSuffix).zip</ReleaseZipPath>
    </PropertyGroup>
    <RemoveDir Directories="$(ReleaseStageDir)" />
    <MakeDir Directories="$(ReleaseStageDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ReleaseStageDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\LICENSE" DestinationFolder="$(ReleaseStageDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Resources\THIRD-PARTY-NOTICES.txt" DestinationFolder="$(ReleaseStageDir)" />
    <ZipDirectory SourceDirectory="$(ReleaseStageDir)" DestinationFile="$(ReleaseZipPath)" Overwrite="true" />
    <Message Importance="high" Text="Release package: $(ReleaseZipPath)" />
  </Target>

</Project>
